# App Store Connect upload credentials for ./scripts/release.sh
# Copy: cp .env.release.example .env.release
# Do NOT put these in .env — that file is bundled as a Flutter asset.

ASC_KEY_ID=
ASC_ISSUER_ID=
# Optional absolute path to the .p8 file (otherwise place it at):
#   ~/.appstoreconnect/private_keys/AuthKey_${ASC_KEY_ID}.p8
# ASC_KEY_PATH=

# Or use Apple ID + app-specific password instead of API key:
# APPLE_ID=
# APPLE_APP_SPECIFIC_PASSWORD=
