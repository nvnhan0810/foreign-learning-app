# Copy to .env and adjust (cp .env.example .env)

# Web app origin (Blade UI loaded in WebView after Google OAuth handoff)
WEBAPP_URL=https://flc.nvnhan0810.com

# API base URL (Sanctum Bearer token auth — same as browser extension)
API_BASE_URL=https://flc.nvnhan0810.com/api

# Local dev:
# Android emulator → host machine:
# WEBAPP_URL=http://10.0.2.2:8080
# API_BASE_URL=http://10.0.2.2:8080/api
# iOS Simulator:
# WEBAPP_URL=http://localhost:8080
# API_BASE_URL=http://localhost:8080/api

# Firebase (FCM) — from Firebase Console → Project settings → Your apps
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_IOS_BUNDLE_ID=com.nvnhan0810.flc
