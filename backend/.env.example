APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://flc.nvnhan0810.com
APP_PORT=8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single,telegram
LOG_TELEGRAM_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Telegram log alerts — package: nvnhan0810/laravel-telegram-logging
# BotFather → token; chat_id: nhắn bot rồi getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_LOG_ENABLED=true
TELEGRAM_LOG_LEVEL=warning
# TELEGRAM_LOG_QUEUE=false
# TELEGRAM_LOG_QUEUE_CONNECTION=
# TELEGRAM_LOG_QUEUE_NAME=
# TELEGRAM_LOG_DEDUPE_SECONDS=60
# TELEGRAM_LOG_TIMEOUT=5
# TELEGRAM_LOG_CONTEXT_MAX_LENGTH=800

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Google OAuth (Chrome extension sign-in)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/api/auth/google/callback"

# Email allowlist — comma-separated; supports *@domain.com
# Example: you@gmail.com,colleague@company.com,*@mycompany.com
FLC_ALLOWED_EMAILS=
# Dev only: set true to allow any Google account
FLC_ALLOW_ALL_EMAILS=false

# Admin panel (/admin) — Google login, comma-separated
FLC_ADMIN_EMAILS=admin@gmail.com

# Cursor Cloud Agents API (listening analysis + word chat web agent)
CURSOR_API_KEY=
CURSOR_API_BASE=https://api.cursor.com
CURSOR_MODEL=composer-2.5
CURSOR_TIMEOUT_SECONDS=180
CURSOR_POLL_INTERVAL_SECONDS=3
CURSOR_HTTP_TIMEOUT_SECONDS=60
CURSOR_CONNECT_TIMEOUT_SECONDS=10
CURSOR_HTTP_RETRIES=1
FLC_MAX_AUDIO_SIZE_MB=50

# Firebase Cloud Messaging (vocab quiz reminders)
FIREBASE_PROJECT_ID=
# Absolute path to service account JSON (Firebase Console → Project settings → Service accounts)
FIREBASE_CREDENTIALS_PATH=storage/app/firebase-service-account.json


SSO_IDP_URL=https://nvnhan0810.com
SSO_SECRET=
